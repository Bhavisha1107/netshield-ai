# Copy this file to .env and fill in your real values. Never commit .env itself.

# PostgreSQL (structured data: users, alerts, incidents, audit logs)
POSTGRES_URL=postgresql://netshield_user:netshield_pass@localhost:5432/netshield

# MongoDB (raw traffic logs)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=netshield

# JWT Auth
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
